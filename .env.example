# --- Database ---
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/atg_mall_dev"

# --- Auth ---
# Long random string used to sign session cookies (openssl rand -base64 48)
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
AUTH_COOKIE_NAME="atg_session"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ATG Mall"
NEXT_PUBLIC_PARENT_COMPANY="Apex Terra Global Limited"
NEXT_PUBLIC_SUPPORT_EMAIL="support@apexterraglobal.com"
NEXT_PUBLIC_SUPPORT_PHONE="+234 704 394 5345"
NEXT_PUBLIC_CORPORATE_SITE="https://apexterraglobal.com"

# --- Payments (PaymentService abstraction — Phase 2) ---
# No provider is wired up yet. When integrating a real provider, add its
# credentials here and implement a Live*PaymentProvider in
# src/lib/services/paymentService.ts — never hardcode keys in source.
PAYSTACK_SECRET_KEY=""
FLUTTERWAVE_SECRET_KEY=""

# --- Notifications (Phase 2) ---
EMAIL_PROVIDER_API_KEY=""
SMS_PROVIDER_API_KEY=""
WHATSAPP_PROVIDER_API_KEY=""

# --- 1688 / Taobao (Phase 2 — requires authorized API access) ---
ONE688_API_KEY=""
TAOBAO_API_KEY=""

# --- CJdropshipping (real, live integration — see src/lib/services/cjDropshippingService.ts) ---
# From CJ dashboard: My CJ -> API -> Generate API Key
CJ_API_KEY=""

# --- Production seed only (npm run db:seed:prod) ---
# Not read by the app itself — only by prisma/seed-production.ts, to create
# the one real admin account for a fresh production database. Set these as
# one-off shell variables when running that command; don't commit real
# values here. See DEPLOYMENT.md.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME=""
