# --- Database ---
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/atg_mall_dev"

# --- Auth ---
# Long random string used to sign session cookies (openssl rand -base64 48)
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
AUTH_COOKIE_NAME="atg_session"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Payments (PaymentService abstraction) ---
# Setting FLUTTERWAVE_SECRET_KEY switches paymentService from the mock
# provider to a real Flutterwave hosted-checkout integration for Card/Bank
# Transfer (Wallet is unaffected either way). FLUTTERWAVE_WEBHOOK_HASH is
# the "secret hash" set under Flutterwave dashboard -> Settings -> Webhooks
# -> used to verify incoming webhook calls are genuinely from Flutterwave.
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""

# --- Notifications ---
# Setting RESEND_API_KEY switches notificationService's EMAIL channel from a
# console-log mock to real delivery via Resend. RESEND_FROM_EMAIL is
# optional — falls back to "ATG Mall <support@apexterraglobal.com>".
# SMS/WhatsApp/Push have no provider wired up yet — see notificationService.ts.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# --- CJdropshipping (real, live integration — see src/lib/services/cjDropshippingService.ts) ---
# From CJ dashboard: My CJ -> API -> Generate API Key
CJ_API_KEY=""

# --- Production seed only (npm run db:seed:prod) ---
# Not read by the app itself — only by prisma/seed-production.ts, to create
# the one real admin account for a fresh production database. Set these as
# one-off shell variables when running that command; don't commit real
# values here. See DEPLOYMENT.md.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME=""
SEED_ADMIN_PHONE=""
