// Marketing / support / ops
// ---------------------------------------------------------------------------

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  IN_APP
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel @default(IN_APP)
  event     String              // e.g. "ORDER_CREATED", "PACKAGE_RECEIVED"
  title     String
  body      String
  isRead    Boolean             @default(false)
  createdAt DateTime            @default(now())

  @@index([userId])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id          String       @id @default(cuid())
  ticketNumber String      @unique
  customerId  String
  customer    User         @relation("TicketCustomer", fields: [customerId], references: [id])
  assigneeId  String?
  assignee    User?        @relation("TicketAssignee", fields: [assigneeId], references: [id])
  subject     String
  status      TicketStatus @default(OPEN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  messages SupportMessage[]
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime      @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String   // e.g. "PRODUCT_UPDATED", "ORDER_STATUS_CHANGED"
  entityType String
  entityId   String
  summary    String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Shipping Calculation Engine (Phase 1 — foundational reference data)
//
// This is a separate system from the legacy `ShippingRate`/`shippingService`
// (kept fully intact — checkout still depends on it until the engine is
// wired in). `Country` (NIGERIA|GAMBIA) is NOT touched by this subsystem —
// it stays the real, operational customer-facing destination set (addresses,
// orders, wallets). `DestinationCountry` below is a separate, open-ended
// reference list for the RATE/QUOTE layer only (admin can add any country
// for rate cards and the Test-Quote tool), bridged to `Country` via ISO code
// ("NIGERIA"<->"NG", "GAMBIA"<->"GM") — see src/lib/services/shipping/.
// ---------------------------------------------------------------------------

model DestinationCountry {
  id        String   @id @default(cuid())
  name      String
  isoCode   String   @unique // e.g. "NG", "GM", "US", "GB"
  region    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rateCards      ShippingRateCard[]
  customsSetting CustomsSetting?

  @@index([isActive])
}

// A physical sourcing/warehouse origin a product ships from — e.g. "China
// Warehouse (Guangzhou)", "USA Warehouse (New Jersey)". Distinct from the
// existing `Warehouse` model (China consolidation/receiving, post-purchase)
// and `Store` (a retail storefront ATG sources from) — this is specifically
// "where does the shipping-cost calculation start from."
model ShippingOrigin {
  id         String   @id @default(cuid())
  name       String
  countryIso String   // e.g. "CN", "US", "GB" — matches DestinationCountry.isoCode convention
  city       String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  products       Product[]
  rateCards      ShippingRateCard[]
  orderShipments OrderShipment[]

  @@index([isActive])
}

model Carrier {
  id               String   @id @default(cuid())
  name             String
  code             String   @unique // e.g. "MANUAL", "DHL", "FEDEX" — "MANUAL" is always present
  isLiveApiEnabled Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  rateCards      ShippingRateCard[]
  orderShipments OrderShipment[]

  @@index([isActive])
}

// Customer-facing checkout pricing tier (Economy/Standard/Express) — NOT the
// same concept as the existing `ShippingMethod` enum, which is the physical
// freight mode warehouse staff pick later (air/sea/courier/LCL/FCL) when
// actually shipping a consolidated package. A service level is just a named
// tier; its actual price/carrier/delivery-estimate/tracking-flag live on the
// `ShippingRateCard` for a specific origin+destination lane, since e.g.
// "Express" from the USA and "Express" from China legitimately use
// different carriers and prices.
model ShippingServiceLevel {
  id        String   @id @default(cuid())
  name      String   @unique // "Economy" | "Standard" | "Express" | admin-added
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rateCards ShippingRateCard[]
}

// Singleton row (exactly one) for engine-wide defaults. Seeded with
// volumetricDivisor=5000 to match the value shippingService.ts already
// hardcodes today — zero behavior change until an admin changes it.
model ShippingGlobalSettings {
  id                       String   @id @default(cuid())
  volumetricDivisor        Int      @default(5000)
  markupEnabled            Boolean  @default(true)
  defaultMarkupPercent     Int      @default(0)
  defaultMarkupFixedMinor  Int      @default(0)
  defaultHandlingFeeMinor  Int      @default(0)
  updatedAt                DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Shipping Calculation Engine (Phase 2 — rate cards)
// ---------------------------------------------------------------------------

// One row per Origin -> Destination(+optional region) -> Service Level lane,
// e.g. "USA -> Gambia -> Express". Weight-bracket pricing lives on the child
// `ShippingRateBracket` rows. markup/handling fields are nullable — null
// means "inherit from ShippingGlobalSettings" (see decision #4 in the plan:
// a rate card is already scoped by origin+destination+method, which covers
// per-origin/per-destination/per-method configuration without a separate
// waterfall-rule table).
model ShippingRateCard {
  id                   String   @id @default(cuid())
  shippingOriginId     String
  shippingOrigin       ShippingOrigin      @relation(fields: [shippingOriginId], references: [id])
  destinationCountryId String
  destinationCountry   DestinationCountry  @relation(fields: [destinationCountryId], references: [id])
  destinationRegion    String?             // sub-national e.g. a state/region name; null = all regions of the country
  serviceLevelId       String
  serviceLevel         ShippingServiceLevel @relation(fields: [serviceLevelId], references: [id])
  carrierId            String
  carrier              Carrier             @relation(fields: [carrierId], references: [id])

  // Plain ISO currency code (not the bounded `Currency` enum) so rate cards
  // can be priced in currencies ATG doesn't otherwise support natively
  // (ZAR, GHS, XOF, ...) — mirrors the existing `ShippingRate.originCountry`
  // precedent of using a plain string specifically for extensibility.
  currency String

  deliveryDaysMin    Int
  deliveryDaysMax    Int
  trackingAvailable  Boolean  @default(true)

  markupEnabled     Boolean? // null = inherit ShippingGlobalSettings.markupEnabled
  markupPercent     Int?     // null = inherit
  markupFixedMinor  Int?     // null = inherit
  handlingFeeMinor  Int?     // null = inherit

  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brackets ShippingRateBracket[]

  @@unique([shippingOriginId, destinationCountryId, destinationRegion, serviceLevelId])
  @@index([isActive])
}

// A weight range within one rate card, e.g. "0-1kg = $20 base + $0/kg" or
// "1-3kg = $20 base + $7.5/kg, min charge $35". maxGrams null = open-ended
// (no upper bound — the last/heaviest bracket on a card).
model ShippingRateBracket {
  id             String           @id @default(cuid())
  rateCardId     String
  rateCard       ShippingRateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
  minGrams       Int
  maxGrams       Int?
  basePriceMinor Int    @default(0)
  pricePerKgMinor Int   @default(0)
  minChargeMinor Int    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([rateCardId])
}

// Optional, per-destination-country customs/duty disclosure. When
// isConfigured=false (the default — nothing here is a real customs
// integration), checkout must show the exact required disclaimer instead of
// implying duties are included. See src/lib/services/shipping/customsService.ts.
model CustomsSetting {
  id                        String   @id @default(cuid())
  destinationCountryId      String   @unique
  destinationCountry        DestinationCountry @relation(fields: [destinationCountryId], references: [id])
  estimatedDutyPercent      Int?
  importTaxPercent          Int?
  customsProcessingFeeMinor Int?
  currency                  String?  // ISO code for customsProcessingFeeMinor, if set
  notes                     String?
  isConfigured              Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

// Admin-managed exchange rates for the shipping engine's currency
// conversions — replaces the hardcoded USD_RATES map in
// currencyConversionService.ts. Plain ISO currency strings (not the bounded
// `Currency` enum) for the same extensibility reason as ShippingRateCard.
// `fetchedAt` lets callers flag a stale rate instead of silently trusting an
// old number — see currencyRateService.ts.
model CurrencyRate {
  id           String   @id @default(cuid())
  fromCurrency String
  toCurrency   String
  rate         Float
  source       String   @default("MANUAL") // "MANUAL" | a future live-provider name
  fetchedAt    DateTime @default(now())
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([fromCurrency, toCurrency])
}

// ---------------------------------------------------------------------------
// Shipping Calculation Engine (Phase 4 — order-time snapshots)
// ---------------------------------------------------------------------------

enum ShippingRateSource {
  MANUAL   // matched an admin-configured ShippingRateCard/Bracket
  LIVE_API // came from a live carrier API
  FALLBACK // a live API was tried and failed; fell back to MANUAL rates
}

// One row per origin-group within an order (see requirement: a cart with
// USA + China products becomes two shipments, shown and charged
// separately). Every field that could otherwise drift if reference data is
// later edited is snapshotted here as plain data, not just a live FK —
// mirrors the exact pattern OrderItem already uses for
// fulfillmentType/costBasisMinor/sourcePlatformSnapshot: "stays accurate
// even if the product/origin/carrier changes later." This is what makes
// "the shipping price on an old order does not change when rates are later
// updated" true by construction, not by convention.
model OrderShipment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  shippingOriginId       String?
  shippingOrigin         ShippingOrigin? @relation(fields: [shippingOriginId], references: [id])
  originNameSnapshot     String
  destinationCountryIso  String // e.g. "NG", "GM" — bridges to Order.destination
  carrierId              String?
  carrier                Carrier?        @relation(fields: [carrierId], references: [id])
  carrierNameSnapshot    String
  serviceLevelNameSnapshot String // e.g. "Express"

  actualWeightGrams     Int
  volumetricWeightGrams Int
  chargeableWeightGrams Int

  carrierCostMinor     Int // before markup/handling/customs
  markupMinor          Int @default(0)
  handlingFeeMinor     Int @default(0)
  customsEstimateMinor Int? // null = not configured/estimated for this lane
  customerPriceMinor   Int // final price the customer was charged for this shipment
  currency             Currency // the order's own (enum-bound) currency — what was actually charged

  estimatedDeliveryDaysMin Int
  estimatedDeliveryDaysMax Int

  rateSource          ShippingRateSource @default(MANUAL)
  rawProviderResponse Json? // live-API response, for audit — null for manual/fallback

  quotedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  items OrderItem[]

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Checkout OTP — email verification code required before ANY purchase
// completes (main checkout, quotation acceptance, digital services). The
// action that would previously execute immediately now only validates
// inputs and stashes them here as `payload`; the actual purchase only runs
// once the emailed code is verified. Single-purpose, short-lived, always
// tied to the (possibly guest) User who's checking out.
// ---------------------------------------------------------------------------

enum OtpPurpose {
  CHECKOUT
  QUOTATION_ACCEPT
  DIGITAL_SERVICE_AIRTIME
  DIGITAL_SERVICE_GIFT_CARD
  DIGITAL_SERVICE_UTILITY_BILL
  WALLET_TRANSFER
  PIN_RESET
}

// One row per device/browser a customer has registered for biometric app
// unlock (Face ID/Touch ID/fingerprint/Windows Hello, via WebAuthn) — never
// the biometric data itself, which never leaves the device. publicKey +
// counter are exactly what WebAuthn needs to verify a signature came from
// that same enrolled authenticator without it being replayed.
model WebAuthnCredential {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt   @default(0)
  deviceLabel  String? // customer-facing label, e.g. "iPhone" — best-effort from the browser's user agent at enrollment time
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

model CheckoutOtp {
  id      String     @id @default(cuid())
  userId  String
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  email   String
  purpose OtpPurpose

  codeHash String // sha256 of the 6-digit code — never store the code itself
  payload  Json // the validated inputs needed to actually execute the purchase once verified

  attempts   Int       @default(0)
  verifiedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([userId])
}
