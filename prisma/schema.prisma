model Commission {
  id          String   @id @default(cuid())
  sellerId    String
  seller      Seller   @relation(fields: [sellerId], references: [id])
  orderItemRef String  @unique
  amountMinor Int
  currency    Currency
  createdAt   DateTime @default(now())
}

